# =======================================================
# MediDropBox Environment Variables Example
# =======================================================
# Copy this file to .env.production and fill in values
# NEVER commit .env.production to git
# =======================================================

# =======================================================
# ENCRYPTION PASSWORD (REQUIRED)
# =======================================================
# Generate: openssl rand -base64 32
# Minimum 32 characters, mix of letters, numbers, symbols
ENCRYPTION_PASSWORD=your-very-strong-password-minimum-32-characters-long

# =======================================================
# CORS ORIGINS (REQUIRED)
# =======================================================
# Format: https://domain1.com,https://domain2.com
# No trailing slashes, include protocol
ALLOWED_ORIGINS=https://app.medidropbox.com,https://admin.medidropbox.com

# =======================================================
# SSL CERTIFICATE (REQUIRED)
# =======================================================
# Path to PKCS12 keystore file
SSL_KEYSTORE_PATH=/etc/ssl/medidropbox/keystore.p12

# Keystore password
SSL_KEYSTORE_PASSWORD=your-keystore-password

# Key alias in keystore
SSL_KEY_ALIAS=medidropbox

# Server port (HTTPS)
SERVER_PORT=8443

# Enable SSL
SSL_ENABLED=true

# =======================================================
# AWS CREDENTIALS (REQUIRED)
# =======================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=medidropbox-reports
AWS_S3_REGION=ap-south-1

# =======================================================
# DATABASE (Already configured with SSL)
# =======================================================
# Database credentials should be in application.properties
# Or use environment variables:
# DB_URL=jdbc:mysql://...
# DB_USERNAME=username
# DB_PASSWORD=password

# =======================================================
# SPRING PROFILE
# =======================================================
SPRING_PROFILES_ACTIVE=production
